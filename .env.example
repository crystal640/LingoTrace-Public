# Supabase browser configuration. The publishable key is safe to expose in
# the client; never place a secret or service-role key in a VITE_ variable.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# GEMINI_API_KEY belongs only in Supabase Edge Function Secrets. Never put it
# in this file or any VITE_ variable.
